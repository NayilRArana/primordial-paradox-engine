# Study copies of decompiled projects. Read only. Never committed, never shipped, never read at runtime.
knowledge/study/

# Generated from data\ by tools\sync_data.py. The source of truth is data\, not this mirror.
game/datafiles/
# The title art mirror, before it moved under game\datafiles\art\ (tools\sync_art.py now
# writes there). These files are the old location's copies of the same tracked sprites in
# game\sprites_src\title\, and the committed .yyp does not reference them: it lists the
# 20 sprites as datafiles/art. Measured 2026-10-21: the live tree still held all 20 copies
# at the old path, and committing them a second time under the old name is what put a
# tracked file in the tree that nothing reads.
game/art/

# Build output and per user IDE state.
build/
*.yyz
*.resource_order
game/.resource_order

# Igor build products and its cache. Measured 2026-10-21: output/ held 17 untracked files
# including PrimordialParadox.exe (7.9 MB) and PrimordialParadox.win, and the repo root
# .gitignore did not cover them, so a build would have committed 8 MB of binary.
#
# The review previews below stay tracked. tests/test_make_env_ship.py,
# tests/test_make_title_world.py and tests/test_sfx.py assert they exist and call them "the
# picture the manager reviews", so a clean checkout must have them. Note the exclusion is
# output/* and not output/: git never descends into an excluded directory, so a negation
# under output/ would be a dead line, which is exactly how the title theme MIDI exceptions
# silently did nothing earlier.
output/*
!output/env_ship_preview.png
!output/nes_ui_preview.png
!output/title_ui_preview.png
!output/ts2_world_preview.png
!output/ts2_bigben_preview.png
!output/sfx_preview_3x.png
!output/render2_demo_preview.png
!output/scene_palettes.json
cache/

{
  "format": 1,
  "kind": "dialogues",
  "dialogue": [
    {
      "id": "ship_rail_note",
      "speaker": "narrator",
      "lines": [
        "* The deck tilts.",
        "* A sailor blocks the hatch.",
        "* He will not move."
      ]
    },
    {
      "id": "battle_intro_sailors",
      "speaker": "narrator",
      "lines": [
        "* A Navy Sailor squares up.",
        "* TALK can calm this.",
        "* FIGHT can end it faster."
      ]
    },
    {
      "id": "talk_navy_sailor",
      "speaker": "sailor",
      "lines": [
        "* \"You are not on the list.\"",
        "* \"The bridge sees all.\"",
        "* \"Go on. I hate the watch.\""
      ]
    },
    {
      "id": "navy_win_kill",
      "speaker": "narrator",
      "lines": [
        "* The sailor does not get up.",
        "* The deck is very quiet."
      ]
    },
    {
      "id": "navy_win_spare",
      "speaker": "narrator",
      "lines": [
        "* He steps aside.",
        "* His eyes stay on the sea.",
        "* \"Bridge is that way.\""
      ]
    },
    {
      "id": "percy_lore_stop",
      "speaker": "narrator",
      "lines": [
        "* Percy fills the doorway.",
        "* \"The sea hears you.\"",
        "* \"Show me the veil.\""
      ]
    },
    {
      "id": "percy_entry",
      "speaker": "percy",
      "lines": [
        "* \"A stowaway with a god.\"",
        "* \"The sea does not care.\"",
        "* Percy lifts the trident."
      ]
    },
    {
      "id": "talk_percy",
      "speaker": "percy",
      "lines": [
        "* \"You still talk. How dull.\"",
        "* \"Ask what the veil is.\"",
        "* \"Ask it plainly.\""
      ]
    },
    {
      "id": "talk_percy_phase2",
      "speaker": "percy",
      "lines": [
        "* \"The tide turns anyway.\"",
        "* \"You asked about the veil.\"",
        "* \"That is the veil.\""
      ]
    },
    {
      "id": "percy_phase2_line",
      "speaker": "percy",
      "lines": [
        "* Percy plants the trident.",
        "* \"So. You have hurt me.\"",
        "* The water answers him."
      ]
    },
    {
      "id": "percy_interrupt_line",
      "speaker": "percy",
      "lines": [
        "* \"Wait. Who says my name?\"",
        "* The trident dips an inch."
      ]
    },
    {
      "id": "prometheus_veil_line",
      "speaker": "prometheus",
      "lines": [
        "* \"Peace, tide-bitten.\"",
        "* \"I am the fire's name.\"",
        "* \"Mortals walk behind a veil\"",
        "* \"It hides gods, not knives.\"",
        "* \"End this here.\"",
        "* \"The dead rise in London.\"",
        "* \"They rise for what sleeps.\""
      ]
    },
    {
      "id": "percy_epilogue_spare",
      "speaker": "narrator",
      "lines": [
        "* Percy sits against the mast.",
        "* \"The fire-carrier took you.\"",
        "* \"The hatch is yours.\""
      ]
    },
    {
      "id": "percy_epilogue_kill",
      "speaker": "narrator",
      "lines": [
        "* The trident lies in two.",
        "* Percy does not move.",
        "* \"The veil thins tonight.\""
      ]
    },
    {
      "id": "percy_win_kill",
      "speaker": "narrator",
      "lines": [
        "* The trident falls first.",
        "* Then the man.",
        "* The sea goes flat."
      ]
    },
    {
      "id": "percy_win_spare",
      "speaker": "percy",
      "lines": [
        "* \"Keep your fire, then.\"",
        "* \"Do not ask me for water.\""
      ]
    },
    {
      "id": "battle_lose",
      "speaker": "narrator",
      "lines": [
        "* The deck rises to meet you.",
        "* Your last save still stands."
      ]
    },
    {
      "id": "battle_intro_hound",
      "speaker": "narrator",
      "lines": [
        "* Something moves by the rope.",
        "* A hound on the deck. It is thin.",
        "* FIGHT ends this in one blow."
      ]
    },
    {
      "id": "talk_deck_hound",
      "speaker": "hound",
      "lines": [
        "* A low growl. Then a thump.",
        "* It sniffs the salt on your hands.",
        "* It waits for you to move first."
      ]
    },
    {
      "id": "hound_win_kill",
      "speaker": "narrator",
      "lines": [
        "* One blow. The hound is still.",
        "* You step over the rope."
      ]
    },
    {
      "id": "hound_win_spare",
      "speaker": "narrator",
      "lines": [
        "* The hound rolls over.",
        "* It lets you pass the rope.",
        "* Its eyes follow the water."
      ]
    },
    {
      "id": "quay_gate_truth",
      "speaker": "guard",
      "pages": [
        {
          "speaker": "guard",
          "lines": [
            "* \"Honest. That is new.\"",
            "* \"Office. Sign in.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* He lifts the arm himself."
          ]
        }
      ]
    },
    {
      "id": "quay_gate_bluff",
      "speaker": "guard",
      "pages": [
        {
          "speaker": "guard",
          "lines": [
            "* \"The list is full.\"",
            "* \"Office, then. Sign.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* He does not look down."
          ]
        }
      ]
    },
    {
      "id": "quay_gate_authority",
      "speaker": "guard",
      "pages": [
        {
          "speaker": "guard",
          "lines": [
            "* \"My officer is asleep.\"",
            "* \"Office. Now.\""
          ]
        },
        {
          "speaker": "narrator",
          "lines": [
            "* He does not believe it."
          ]
        }
      ]
    },
    {
      "id": "say_door_register",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Registry office. Shut."
          ]
        }
      ]
    },
    {
      "id": "say_door_dancing_man",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* A pub. Warm and loud."
          ]
        }
      ]
    },
    {
      "id": "say_door_oceana",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Flats. Every bell dead."
          ]
        }
      ]
    },
    {
      "id": "say_door_telephone",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Telephone House. No call."
          ]
        }
      ]
    },
    {
      "id": "say_door_kuti",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* A kitchen, still open."
          ]
        }
      ]
    },
    {
      "id": "say_door_red_funnel",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* Ferries. Not your ship."
          ]
        }
      ]
    },
    {
      "id": "say_door_playhouse",
      "speaker": "narrator",
      "pages": [
        {
          "lines": [
            "* A door with no light."
          ]
        }
      ]
    }
  ]
}
